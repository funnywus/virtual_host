PORT=3000

# 必填：至少 16 位随机字符串，禁止使用占位默认值（启动会 fail-fast）
JWT_SECRET=replace_with_a_long_random_string
UPLOAD_SIGN_SECRET=replace_with_another_long_random_string
# 敏感字段加密密钥（推荐 64 位 hex：openssl rand -hex 32）
DATA_ENCRYPTION_KEY=replace_with_64_hex_chars_from_openssl_rand_hex_32

# 开放注册开关（默认关闭；管理员请用 /api/users 创建账号）
ALLOW_REGISTER=false

# 为 true 时拒绝「域名 MD5」历史弱授权码登录，要求管理员重置
FORCE_LEGACY_AUTH_RESET=false

# CORS 允许的 Origin，逗号分隔；空则仅放行 localhost；* 表示全部（不推荐）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JSON body 限制（全局默认 / 上传路由）
JSON_BODY_LIMIT=2mb
UPLOAD_JSON_LIMIT=64mb

# 数据库配置 (sqlite 或 mysql)
DB_TYPE=sqlite
DB_PATH=./data/app.db

# MySQL（DB_TYPE=mysql 时生效；也兼容 DB_HOST / DB_USER / DB_PASSWORD / DB_NAME）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=virtual_host
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=virtual_host

# 限流（15 分钟窗口内最大次数）
RATE_LIMIT_LOGIN=30
RATE_LIMIT_UPLOAD_AUTH=60

# 分片上传磁盘水位：可用空间须 ≥ 文件体积×2 + 该值（默认 1GB）
# CHUNK_DISK_WATERMARK_BYTES=1073741824

# SSH 连接池：每主机最大连接数 / 等待空闲超时（毫秒）
# SSH_POOL_MAX_PER_HOST=5
# SSH_POOL_WAIT_MS=15000

ALIYUN_ACCESS_KEY=
ALIYUN_SECRET_KEY=
ALIYUN_REGION=cn-hangzhou
